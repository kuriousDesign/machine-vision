#VIDEO_PATH=/app/videos

# MQTT broker
MQTT_BROKER_IP=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=Admin1234

# File storage root (mounted volume in Docker) (THIS MAY NOT BE USED ANYMORE)
#STORAGE_ROOT=/data/videos

RECORDINGS_DIR=/opt/recordings

# Capture tuning. Lower these if multi-camera connections open successfully
# but fail on the first frame read because of USB/controller bandwidth limits.
CAPTURE_WIDTH=1920
CAPTURE_HEIGHT=1080

# When enabled, a lost heartbeat disconnects active cameras instead of moving
# the device step into ABORTING.
DISCONNECT_CAMERAS_ON_HEARTBEAT_TIMEOUT=false

# MACHINE CFG - MachineIds enum found in src/machine_cfg.py
MACHINE_ID=TUBELINER_002551

POLL_PERIOD_SECONDS=5

# Stream-only settings used by the single-container supervisor variant.
# By default, this IPC continuously streams only the Screener (camera 0).
# On the other IPC, set STREAM_ONLY_CAMERA_IDS=1,2,3 to stream the
# Extruder, Beakers, and Mixing Bowl at the same time.
# Set STREAM_ONLY_GROUP_CONTROL_ENABLED=true to restore MQTT/UI group switching.
STREAM_ONLY_CAMERA_ID=0
STREAM_ONLY_CAMERA_NAME=Screener
STREAM_ONLY_CAMERA_USB_PORT=3-4.4
STREAM_ONLY_CONNECTION_SEARCH_TYPE=USB_PORT
STREAM_ONLY_STREAM_PORT=8000
STREAM_ONLY_REQUESTED_FPS=10
STREAM_ONLY_AUTO_STREAM=true
STREAM_ONLY_RECONNECT_DELAY_MS=1000
STREAM_ONLY_STATUS_PUBLISH_ENABLED=true
STREAM_ONLY_STATUS_TOPIC=vision_00254/vision_stream/0/status
STREAM_ONLY_STATUS_PUBLISH_INTERVAL_MS=1000
STREAM_ONLY_POLL_PERIOD_MS=1000

# Comma-separated camera IDs for continuous streaming. Defaults to camera 0.
STREAM_ONLY_CAMERA_IDS=0
STREAM_ONLY_GROUP_CONTROL_ENABLED=false